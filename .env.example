# Optionnel : quand le projet Supabase est actif + migration plugin_catalog appliquée.
# Sans ces variables, le store lit /api/catalog (JSON repo) puis le fallback static.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- HoopsLive OBS Chrono (VPS) ---
# Never commit real secrets. Fail-closed: API returns 401 if TOKEN is empty.
HOOPSLIVE_OBS_TOKEN=
# Overlay path segment after /hl-obs/ (primary). Fallback: HOOPSLIVE_OBS_PUBLIC_PATH_SECRET
OBS_PATH_SECRET=replace-me
HOOPSLIVE_OBS_PUBLIC_PATH_SECRET=
# Public HTTPS origin without trailing slash, e.g. https://store.hoopslive.ch
HOOPSLIVE_OBS_PUBLIC_BASE=
# Optional restricted CORS origin
HOOPSLIVE_OBS_CORS_ORIGIN=
# Optional CSV of allowed client IPs
HOOPSLIVE_OBS_IP_ALLOWLIST=
