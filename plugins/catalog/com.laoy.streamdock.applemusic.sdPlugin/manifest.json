{
  "Author": "Laoy",
  "Category": "Apple Music",
  "CategoryIcon": "static/icon/applemusic.png",
  "CodePath": "index.html",
  "Description": "Apple Music controls for StreamDock via Cider (local API on port 10767)",
  "Icon": "static/icon/applemusic.png",
  "Name": "Apple Music (Cider)",
  "Version": "0.3.0",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "2.0.0"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Actions": [
    {
      "Name": "Play / Pause",
      "UUID": "com.laoy.streamdock.applemusic.playpause",
      "Icon": "static/icon/play.png",
      "States": [
        {
          "Image": "static/icon/play.png",
          "TitleAlignment": "middle",
          "FontSize": "10"
        },
        {
          "Image": "static/icon/pause.png",
          "TitleAlignment": "middle",
          "FontSize": "10"
        }
      ],
      "Tooltip": "Toggle play/pause in Cider",
      "Context": "GLOBAL"
    },
    {
      "Name": "Previous",
      "UUID": "com.laoy.streamdock.applemusic.previous",
      "Icon": "static/icon/previous.png",
      "States": [
        {
          "Image": "static/icon/previous.png",
          "TitleAlignment": "middle",
          "FontSize": "10"
        }
      ],
      "Tooltip": "Previous track",
      "Context": "GLOBAL"
    },
    {
      "Name": "Next",
      "UUID": "com.laoy.streamdock.applemusic.next",
      "Icon": "static/icon/next.png",
      "States": [
        {
          "Image": "static/icon/next.png",
          "TitleAlignment": "middle",
          "FontSize": "10"
        }
      ],
      "Tooltip": "Next track",
      "Context": "GLOBAL"
    },
    {
      "Name": "Volume Up",
      "UUID": "com.laoy.streamdock.applemusic.volumeup",
      "Icon": "static/icon/volume_up.png",
      "States": [
        {
          "Image": "static/icon/volume_up.png",
          "TitleAlignment": "middle",
          "FontSize": "10"
        }
      ],
      "Tooltip": "Increase Cider volume",
      "Context": "GLOBAL"
    },
    {
      "Name": "Volume Down",
      "UUID": "com.laoy.streamdock.applemusic.volumedown",
      "Icon": "static/icon/volume_down.png",
      "States": [
        {
          "Image": "static/icon/volume_down.png",
          "TitleAlignment": "middle",
          "FontSize": "10"
        }
      ],
      "Tooltip": "Decrease Cider volume",
      "Context": "GLOBAL"
    },
    {
      "Name": "Shuffle",
      "UUID": "com.laoy.streamdock.applemusic.shuffle",
      "Icon": "static/icon/shuffle.png",
      "States": [
        {
          "Image": "static/icon/shuffle.png",
          "TitleAlignment": "middle",
          "FontSize": "10"
        },
        {
          "Image": "static/icon/shuffle_on.png",
          "TitleAlignment": "middle",
          "FontSize": "10"
        }
      ],
      "Tooltip": "Toggle shuffle",
      "Context": "GLOBAL"
    },
    {
      "Name": "Repeat",
      "UUID": "com.laoy.streamdock.applemusic.repeat",
      "Icon": "static/icon/repeat.png",
      "States": [
        {
          "Image": "static/icon/repeat.png",
          "TitleAlignment": "middle",
          "FontSize": "10"
        },
        {
          "Image": "static/icon/repeat_on.png",
          "TitleAlignment": "middle",
          "FontSize": "10"
        }
      ],
      "Tooltip": "Cycle repeat mode",
      "Context": "GLOBAL"
    },
    {
      "Name": "Now Playing",
      "UUID": "com.laoy.streamdock.applemusic.songinfo",
      "Icon": "static/icon/songinfo.png",
      "PropertyInspector": "propertyInspector/cider/index.html",
      "States": [
        {
          "Image": "static/icon/songinfo.png",
          "TitleAlignment": "bottom",
          "FontSize": "9"
        }
      ],
      "Tooltip": "Show current track title — open PI to set Cider apptoken",
      "Context": "GLOBAL"
    },
    {
      "Name": "Love / Favorite",
      "UUID": "com.laoy.streamdock.applemusic.love",
      "Icon": "static/icon/love.png",
      "States": [
        {
          "Image": "static/icon/love.png",
          "TitleAlignment": "middle",
          "FontSize": "10"
        },
        {
          "Image": "static/icon/love_on.png",
          "TitleAlignment": "middle",
          "FontSize": "10"
        }
      ],
      "Tooltip": "Toggle Favorite / Love in Apple Music",
      "Context": "GLOBAL"
    },
    {
      "Name": "Add to Library",
      "UUID": "com.laoy.streamdock.applemusic.addtolibrary",
      "Icon": "static/icon/add_library.png",
      "States": [
        {
          "Image": "static/icon/add_library.png",
          "TitleAlignment": "middle",
          "FontSize": "10"
        }
      ],
      "Tooltip": "Add current song to your Apple Music library",
      "Context": "GLOBAL"
    },
    {
      "Name": "Forward +15s",
      "UUID": "com.laoy.streamdock.applemusic.seekforward",
      "Icon": "static/icon/forward.png",
      "States": [
        {
          "Image": "static/icon/forward.png",
          "TitleAlignment": "middle",
          "FontSize": "10"
        }
      ],
      "Tooltip": "Fast forward 15 seconds",
      "Context": "GLOBAL"
    },
    {
      "Name": "Rewind -15s",
      "UUID": "com.laoy.streamdock.applemusic.seekbackward",
      "Icon": "static/icon/rewind.png",
      "States": [
        {
          "Image": "static/icon/rewind.png",
          "TitleAlignment": "middle",
          "FontSize": "10"
        }
      ],
      "Tooltip": "Rewind 15 seconds",
      "Context": "GLOBAL"
    },
    {
      "Name": "Clear Queue",
      "UUID": "com.laoy.streamdock.applemusic.clearqueue",
      "Icon": "static/icon/clear_queue.png",
      "States": [
        {
          "Image": "static/icon/clear_queue.png",
          "TitleAlignment": "middle",
          "FontSize": "10"
        }
      ],
      "Tooltip": "Clear the Apple Music queue",
      "Context": "GLOBAL"
    },
    {
      "Name": "Volume (Molette)",
      "UUID": "com.laoy.streamdock.applemusic.volumecontrol",
      "Icon": "static/icon/volume_control.png",
      "DisableAutomaticStates": true,
      "States": [
        {
          "Image": "static/icon/volume_control.png",
          "TitleAlignment": "center",
          "FontSize": "10"
        },
        {
          "Image": "static/icon/volume_mute.png",
          "TitleAlignment": "center",
          "FontSize": "10"
        }
      ],
      "Settings": {
        "step": 0.05
      },
      "Controllers": [
        "Knob"
      ],
      "Tooltip": "Ajuster le volume (tourner) et Mute (appuyer)",
      "Context": "GLOBAL"
    },
    {
      "Name": "Précédent / Suivant (Molette)",
      "UUID": "com.laoy.streamdock.applemusic.previousornext",
      "Icon": "static/icon/prevornext.png",
      "DisableAutomaticStates": true,
      "States": [
        {
          "Image": "static/icon/prevornext.png",
          "TitleAlignment": "center",
          "FontSize": "10"
        }
      ],
      "Controllers": [
        "Knob"
      ],
      "Tooltip": "Piste suivante/précédente (tourner) et Play/Pause (appuyer)",
      "Context": "GLOBAL"
    },
    {
      "Name": "Timeline / Seek (Molette)",
      "UUID": "com.laoy.streamdock.applemusic.seekcontrol",
      "Icon": "static/icon/seek_control.png",
      "DisableAutomaticStates": true,
      "States": [
        {
          "Image": "static/icon/seek_control.png",
          "TitleAlignment": "center",
          "FontSize": "10"
        }
      ],
      "Settings": {
        "step": 5
      },
      "Controllers": [
        "Knob"
      ],
      "Tooltip": "Avancer / Reculer dans le morceau (tourner) et Play/Pause (appuyer)",
      "Context": "GLOBAL"
    }
  ]
}