{
  "toggleMute": {
    "type": "api",
    "description": "Toggle microphone mute in Discord voice",
    "params": {
      "currentMute": { "type": "boolean", "required": true }
    }
  },
  "toggleDeafen": {
    "type": "api",
    "description": "Toggle headset deafen in Discord voice",
    "params": {
      "currentDeaf": { "type": "boolean", "required": true }
    }
  },
  "joinVoiceChannel": {
    "type": "api",
    "description": "Join or leave a specific Discord voice channel",
    "params": {
      "channelId": { "type": "string", "required": true },
      "currentChannelId": { "type": "string", "required": false }
    }
  },
  "toggleCamera": {
    "type": "api",
    "description": "Toggle webcam video in Discord voice",
    "params": {
      "currentCameraOn": { "type": "boolean", "required": true }
    }
  },
  "toggleScreenshare": {
    "type": "shortcut",
    "description": "Toggle screenshare via Discord keybind (Ctrl+Shift+F9)",
    "value": "ctrl+shift+F9",
    "params": {
      "keybind": { "type": "string", "required": false, "default": "ctrl+shift+F9" },
      "sourceId": { "type": "string", "required": false },
      "sourceType": { "type": "string", "required": false, "enum": ["screen", "window"] }
    }
  },
  "playSoundboardSound": {
    "type": "api",
    "description": "Play a sound from the Discord Soundboard in the current voice channel",
    "params": {
      "soundId": { "type": "string", "required": true },
      "guildId": { "type": "string", "required": true }
    }
  },
  "connect": {
    "type": "api",
    "description": "Connect or reconnect the Discord RPC session",
    "params": {}
  }
}
