# Secrets Edge Functions (ne jamais committer de vraies clés).
# Copier vers supabase/functions/.env pour `supabase functions serve --env-file …`
# ou `supabase secrets set --env-file …` en prod.

# Feature flags — test par défaut ; live gated.
PAYMENTS_ENABLED=false
STRIPE_LIVE_ENABLED=false

# Stripe test mode (Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Price IDs créés au Dashboard quand un plugin est prêt (ne pas inventer d’IDs réels ici).
# Grille produit figée : plugin solo 5.99 CHF/mois · annuel suggéré 39 CHF/an
# (voir docs/PAYMENTS.md §0). Noms PREMIUM_* = squelette technique du 1er price branché.
STRIPE_PRICE_PREMIUM_MONTHLY=price_REPLACE_MONTHLY
STRIPE_PRICE_PREMIUM_YEARLY=price_REPLACE_YEARLY

# Redirections Checkout (UI desktop Vite en dev)
SITE_URL=http://127.0.0.1:5173
CHECKOUT_SUCCESS_PATH=/?checkout=success
CHECKOUT_CANCEL_PATH=/?checkout=cancel

# Fournis automatiquement sur la plateforme Supabase ;
# utiles en local si vous servez les functions hors `supabase start`.
# SUPABASE_URL=https://fkzywcoymqyfoufvtedl.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
